; Metallic-RC — original native desktop meadow client.
config_version=5

[application]
config/name="Metallic-RC"
run/main_scene="res://main.tscn"
; Readiness and lifecycle lines must reach a supervisor pipe in release exports.
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Metallic Meadow — a small shared place to play."
config/version="0.1.0"

[autoload]
Session="*res://scripts/session.gd"

[display]
window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.65, 0.82, 0.86, 1)
lights_and_shadows/directional_shadow/size=2048

[audio]
driver/enable_input=false
