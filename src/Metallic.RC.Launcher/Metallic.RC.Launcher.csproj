<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Metallic.RC.Launcher</AssemblyName>
    <RootNamespace>Metallic.RC.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.0</Version>
    <Description>Metallic-RC local client launcher and creator tools</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Metallic.RC.Core/Metallic.RC.Core.csproj" />
    <ProjectReference Include="../Metallic.RC.Compatibility/Metallic.RC.Compatibility.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>
</Project>
